# TP4 - Variables d'environnement (copier vers .env pour personnaliser : cp .env.example .env)
# L'application Spring lit ces variables dans les profils postgres/axonserver de application.yml,
# et Docker Compose les résout dans compose.yaml.

# ============================= PostgreSQL =============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=event_sourcing_account_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# ============================= pgAdmin ================================
PGADMIN_PORT=8088
# pgAdmin rejette les domaines speciaux (.local, .test...)
PGADMIN_DEFAULT_EMAIL=admin@tp4-cqrs.com
PGADMIN_DEFAULT_PASSWORD=admin

# ============================= Axon Server ============================
AXONSERVER_HTTP_PORT=8024
AXONSERVER_GRPC_PORT=8124
# Contact point publié par Axon Server aux clients :
#  - localhost    : application exécutée sur l'hôte (mvnw spring-boot:run) — démo du cours ;
#  - axonserver   : application exécutée dans Docker (profil Compose 'full').
AXONSERVER_HOSTNAME=localhost

# ==================== Application (profil 'full') =====================
APP_PORT=8066
